# --- API de contact (FastAPI) ---
ENVIRONMENT=development

# Base de données : SQLite en dev, PostgreSQL en production.
DATABASE_URL=sqlite:///./contact.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/vakom

# Origines autorisées (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Limite de débit de l'endpoint de contact.
CONTACT_RATE_LIMIT=5/minute
# Stockage du rate-limiter : memory:// en dev, redis://host:6379 en prod multi-instances.
RATE_LIMIT_STORAGE_URI=memory://

# Notification e-mail (optionnelle). Laisser vide pour désactiver.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_TO=
