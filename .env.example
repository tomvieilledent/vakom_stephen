# --- Frontend (Vite) ---
# Endpoint du formulaire de contact.
# - Laisser vide ou "/api/contact" si le backend est servi sous le même domaine.
# - Sinon, URL absolue de l'API (ex. https://api.stephen-consultant.fr/api/contact).
VITE_CONTACT_ENDPOINT=/api/contact

# --- Mesure d'audience (optionnelle, privacy-first) ---
# Laisser vide pour désactiver totalement l'analytics ET la bannière de consentement.
# Renseigner le domaine suivi pour activer un suivi respectueux (ex. Plausible),
# chargé uniquement après consentement explicite de l'utilisateur.
# VITE_ANALYTICS_DOMAIN=stephen-consultant.fr
# VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
